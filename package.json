{
  "name": "notability-live-region",
  "version": "1.0.0",
  "private": true,
  "description": "Keep Notability notes beside Markdown and copy visual regions or complete pages as internal links and embeds.",
  "license": "MIT",
  "author": "Cédric Sipakam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CedricS789/notability-live-region.git"
  },
  "bugs": {
    "url": "https://github.com/CedricS789/notability-live-region/issues"
  },
  "homepage": "https://github.com/CedricS789/notability-live-region#readme",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "tsx --test tests/*.test.ts",
    "test:deploy": "node --test tests/deploy.test.mjs",
    "test:bundle": "node --test tests/bundle.test.mjs",
    "test:publication": "node --test tests/publication.test.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:deploy && npm run build && npm run verify:release && npm run test:bundle && npm run test:publication",
    "deploy": "npm run check && node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^26.2.0",
    "@typescript-eslint/parser": "8.67.0",
    "esbuild": "^0.25.9",
    "eslint": "10.8.1",
    "eslint-plugin-obsidianmd": "0.4.1",
    "jsdom": "^26.1.0",
    "obsidian": "1.13.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
